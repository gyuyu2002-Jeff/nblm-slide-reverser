# 環境變數與機密資訊（絕對禁止 Commit）
.env
.env.*
*.env

# Python 快取與虛擬環境
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 編輯器與 IDE 設定檔
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 暫存與日誌
*.log
*.tmp
*.bak
temp/
tmp/

# 作業系統特定檔案
.DS_Store
Thumbs.db
desktop.ini

# Autopilot 自動化產物與機密金鑰保護
autopilot/config.json
autopilot/input/*
!autopilot/input/.gitkeep
autopilot/output/01_extracted/*
!autopilot/output/01_extracted/.gitkeep
autopilot/output/02_prompts/*
!autopilot/output/02_prompts/.gitkeep
autopilot/output/03_nblm_slides/*
!autopilot/output/03_nblm_slides/.gitkeep
autopilot/output/04_evaluations/*
!autopilot/output/04_evaluations/.gitkeep

